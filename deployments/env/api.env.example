# Template for deployments/init-source.py; contains no production secrets.
DEBUG=0
SECRET_KEY=${DJANGO_SECRET_KEY}
CORS_ALLOWED_ORIGINS=${BASE_URL}
POSTGRES_HOST=pg-egress
POSTGRES_PORT=15432
POSTGRES_USER=${DB_USER}
POSTGRES_PASSWORD=${DB_PASSWORD}
POSTGRES_DB=${DB_NAME}
DATABASE_URL=${DATABASE_URL}
REDIS_URL=redis://plane-redis:6379/
REDIS_HOST=plane-redis
REDIS_PORT=6379
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=${MQ_PASSWORD}
RABBITMQ_VHOST=plane
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=${S3_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${S3_SECRET_KEY}
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
USE_MINIO=1
MINIO_ENDPOINT_SSL=0
FILE_SIZE_LIMIT=5242880
WEB_URL=${BASE_URL}
APP_BASE_URL=${BASE_URL}
APP_BASE_PATH=
ADMIN_BASE_URL=${BASE_URL}
ADMIN_BASE_PATH=/god-mode
SPACE_BASE_URL=${BASE_URL}
SPACE_BASE_PATH=/spaces
LIVE_BASE_URL=${BASE_URL}
LIVE_BASE_PATH=/live
LIVE_SERVER_SECRET_KEY=${LIVE_SECRET_KEY}
GUNICORN_WORKERS=2
# Threads per gunicorn worker. The API is served over WSGI (gthread) so that
# pooled PostgreSQL connections are actually reused; see
# apps/api/bin/docker-entrypoint-api.sh.
GUNICORN_THREADS=20
# Keep each DB connection open this long instead of Django's default of one
# connection per request. Health checks replace any the server dropped.
DB_CONN_MAX_AGE=300
DB_CONN_HEALTH_CHECKS=1
DOCKERIZED=1
