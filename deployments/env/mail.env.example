# Optional SMTP reference; copy to .deploy/mail.env and replace placeholders.
# Configure the same values in God mode -> Email; existing DB configuration
# takes precedence over env vars, so changing .env alone is not sufficient.
ENABLE_SMTP=1
EMAIL_HOST=smtp.qiye.163.com
EMAIL_PORT=465
EMAIL_HOST_USER=YOUR_EMAIL_ADDRESS
EMAIL_HOST_PASSWORD='YOUR_SMTP_AUTHORIZATION_CODE'
EMAIL_FROM=YOUR_EMAIL_ADDRESS
EMAIL_USE_SSL=1
EMAIL_USE_TLS=0
